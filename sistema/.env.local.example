# ============================================================
# BARBOS — variaveis de ambiente
#
# Copie este arquivo para .env.local (que NAO vai pro git) e preencha.
# Onde achar: Supabase → seu projeto → Project Settings → API
# ============================================================

# "Project URL". Algo como https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave "anon" / "public" (nas contas novas aparece como "publishable",
# comecando com sb_publishable_). E publica por design: vai no navegador e o
# que protege os dados e o RLS do banco, nao o segredo da chave.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NUNCA colocar aqui a chave "service_role" / "secret". Ela ignora RLS
# inteiro. Se um dia precisar dela, use outra variavel SEM o prefixo
# NEXT_PUBLIC_ (o prefixo publica a variavel no navegador).

# ------------------------------------------------------------
# Conta de teste
#
# Todo teste do sistema acontece na barbearia "Gabriel Teste" — nunca numa
# conta criada na hora. Conta criada por conveniência vira lixo permanente:
# apagar usuário exige a chave `service_role`, que não entra neste projeto.
#
# Confira com: npm run teste:conta
# ------------------------------------------------------------
BARBOS_EMAIL_TESTE=
BARBOS_SENHA_TESTE=
