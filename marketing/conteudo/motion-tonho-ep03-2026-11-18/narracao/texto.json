    {"id": "f01", "pausa": 0.35, "texto": "Terça, quatro da tarde."},
    {"id": "f02", "pausa": 0.30, "texto": "A cadeira está pronta."},
    {"id": "f03", "pausa": 0.75, "texto": "O cliente não veio."},
