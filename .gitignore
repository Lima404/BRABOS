# Sistema operacional
.DS_Store
Thumbs.db

# Editores
.vscode/
.idea/

# Claude Code (sessões locais, não devem ir pro repo)
.claude/projects/
.claude/sessions/
.claude/shell-snapshots/
.claude/telemetry/
.claude/file-history/
.claude/backups/

# Dependências
node_modules/

# Arquivos temporários
*.log
*.tmp

# Drop zone do usuário (só o README vai versionado)
dados/*
!dados/README.md

# Variaveis de ambiente — em QUALQUER nivel.
# O sistema/ ja tem a propria regra; esta aqui e a rede de baixo, pra um
# .env largado na raiz nao entrar no repositorio sem ninguem ver.
.env
.env.*
!.env.example
!.env.*.example
